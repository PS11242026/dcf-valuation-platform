# SBC treatment (research toggle). Default 0.0 = canonical model: stock-based comp
# fully expensed (conservative; best in low-SBC sectors). Set 0.5 for software/SaaS/
# platform-heavy work -- adds back 50% of SBC to operating income, recovering most of
# the 3-5y predictive-IC gain where SBC is material (software 3y IC +33%, 5y +16%) with
# minimal cost elsewhere. Leave at 0.0 for the canonical default.
DCF_SBC_ADDBACK_FRACTION=0.0

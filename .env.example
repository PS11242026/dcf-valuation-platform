DCF_EQUITY_RISK_PREMIUM=0.045
DCF_DEFAULT_COST_OF_DEBT=0.045
DCF_DEFAULT_TAX_RATE=0.21
DCF_TERMINAL_GROWTH_CAP=0.035
DCF_DEFAULT_TERMINAL_GROWTH=0.025
DCF_NORMALIZE_CAPEX=true
